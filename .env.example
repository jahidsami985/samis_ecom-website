# Django
DEBUG=True
SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,your-render-service.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-render-service.onrender.com

# Aiven for MySQL
DB_ENGINE=django.db.backends.mysql
MYSQL_DATABASE=defaultdb
MYSQL_USER=avnadmin
MYSQL_PASSWORD=change-me
MYSQL_HOST=your-aiven-mysql-host.aivencloud.com
MYSQL_PORT=12345
MYSQL_SSL_CA=ca.pem
# For Render, prefer pasting the full Aiven CA certificate into this env var:
# MYSQL_SSL_CA_CONTENT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Email / OTP
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_HOST_USER=change-me
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=change-me

# SSLCommerz payment gateway
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_API_URL=
SSLCOMMERZ_VALIDATION_API=
